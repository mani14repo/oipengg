# PUMA Journey Intelligence — Environment Variables
# Copy to .env and configure for your environment.

# Frontend data mode: mock | api
VITE_DATA_MODE=mock

# BFF server base URL (used by the frontend API client)
VITE_API_BASE_URL=http://localhost:3001

# ─── BFF Server (server-side only — never expose in browser) ─────────────────

# ServiceNow instance
SERVICENOW_INSTANCE=https://YOUR_INSTANCE.service-now.com

# ServiceNow authentication (use OAuth client credentials in production)
# SERVICENOW_USERNAME=api_user
# SERVICENOW_PASSWORD=...
# SERVICENOW_CLIENT_ID=...
# SERVICENOW_CLIENT_SECRET=...

# BFF server port
PORT=3001

# Data mode for BFF: mock | live
DATA_MODE=mock
